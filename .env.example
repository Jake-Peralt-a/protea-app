# --- Database ---
DATABASE_URL="postgresql://protea:protea@localhost:5433/protea?schema=public"

# --- Auth ---
AUTH_SECRET="replace-with-openssl-rand-hex-32"
APP_URL="http://localhost:3000"

# --- Uploads / storage ---
STORAGE_DRIVER="local"          # local | s3
STORAGE_LOCAL_DIR=".storage"
MAX_UPLOAD_BYTES="10485760"     # 10 MB
ALLOWED_UPLOAD_TYPES="image/png,image/jpeg,image/webp,application/pdf"
DOCUMENT_RETENTION_DAYS="365"

# --- S3 (only when STORAGE_DRIVER=s3) ---
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Email notifications ---
EMAIL_DRIVER="log"             # log | smtp
EMAIL_FROM="no-reply@futureprotea.example"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# --- Seed admin ---
SEED_ADMIN_EMAIL="admin@futureprotea.example"
SEED_ADMIN_PASSWORD="Admin123!"
